class Solution {
    public int[] plusOne(int[] arr) {
        int len=arr.length; 

        for(int i=len-1;i>=0;i--){
            if(arr[i]<9){
                arr[i]++;
                return arr;
            }
            arr[i]=0;
        }
    
    int[] result=new int[len+1];
    result[0] = 1;
    return result;
}
}
