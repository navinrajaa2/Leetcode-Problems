class Solution {
    public String toLowerCase(String s) {
        StringBuilder navin=new StringBuilder();
        for(int i=0;i<s.length();i++){
            if(s.charAt(i)>=65&&s.charAt(i)<=90){
                navin.append((char)(s.charAt(i)+32));
            }
            else{
                navin.append(s.charAt(i));
            }
        }
        return navin.toString();
    }
}
