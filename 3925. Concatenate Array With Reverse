class Solution {
    public int[] concatWithReverse(int[] nums) {
        int n=nums.length;
        int[] answer=new int[n*2];
        for(int i=0;i<n;i++){
            answer[i]=nums[i];
        }
        for(int i=0;i<n;i++){
            answer[i+n]=nums[n-i-1];
        }
        return answer;
    }
}
