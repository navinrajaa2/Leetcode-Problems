class Solution {
    public ListNode deleteMiddle(ListNode head) {
        if(head.next==null){
            return null;
        }
        ListNode current=head;
        int n=0;
        while(current!=null){
            n++;
            current=current.next;
        }
        int middle=n/2;
        current=head;
        for(int i=0;i<middle-1;i++){
            current=current.next;
        }
        current.next=current.next.next;
        return head;
    }
}
