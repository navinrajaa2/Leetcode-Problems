class Solution {
    public int getLucky(String s, int k) {
        int sum=0;
        for(int i=0;i<s.length();i++){
            int value=s.charAt(i)-'a'+1;
            while(value>0){
                sum+=value%10;
                value/=10;
            }
        }
        for (int i = 1; i < k; i++) {
            sum = sumofdigit(sum);
        }

        return sum;
    }
    public int sumofdigit(int n){
        int total=0;
        while(n>0){
           total+=n%10;
           n/=10;
        }
        return total;
    }
}
