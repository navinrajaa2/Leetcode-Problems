class Solution {
    public int climbStairs(int n) {
        if (n == 0 || n == 1)
            return 1;
        int navin = 1, rajaa = 1;
        for (int i = 2; i <= n; i++) {
            int temp = navin;
            navin = rajaa + navin;
            rajaa = temp;
        }
        return navin;
    }
}
