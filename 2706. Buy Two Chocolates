class Solution {
    public int buyChoco(int[] prices, int money) {
        int max1=Integer.MAX_VALUE;
        int max2=Integer.MAX_VALUE;
        int answer=0;
        for(int ele:prices){
            if(ele<max1){
                max2=max1;
                max1=ele;
            }
            else if(ele<max2){
                max2=ele;
            }
        }
        answer=max1+max2;
        if(answer>money)return money;
        return money-answer;
    }
}
