class Solution {
    public int[] separateDigits(int[] nums) {
        int n=nums.length;
        ArrayList<Integer>navin=new ArrayList<>();
        for(int ele:nums){
            String s=String.valueOf(ele);
            for(int i=0;i<s.length();i++){
                navin.add(s.charAt(i)-'0');
            }
        }
        int n1=navin.size();
        int []answer=new int[n1];
        for(int i=0;i<n1;i++){
            answer[i]=navin.get(i);
        }
        return answer;
    }
}
