class Solution {
    public boolean detectCapitalUse(String word) {
        int upper=0;
        int n=word.length();
        for(char ch:word.toCharArray()){
            if(Character.isUpperCase(ch)){
                upper++;
            }
        }
        return upper == n ||upper == 0 ||(upper == 1 && Character.isUpperCase(word.charAt(0)));
    }
}
