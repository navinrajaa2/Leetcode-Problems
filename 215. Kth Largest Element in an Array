class Solution {
    public int findKthLargest(int[] nums, int k) {
        int n=nums.length;
        QuickSort(nums,0,n-1);
        return nums[n-k];
    }
    public void QuickSort(int arr[],int low,int high){
        if(low>=high)return;
        int s=low;
        int e=high;
        int m=s+(e-s)/2;
        int pivot=arr[m];
        while(s<=e){
            while(arr[s]<pivot)s++;
            while(arr[e]>pivot)e--;
            if(s<=e){
                int temp=arr[s];
                arr[s]=arr[e];
                arr[e]=temp;
                s++;
                e--;
            }
        }
        QuickSort(arr,low,e);
        QuickSort(arr,s,high);
    }
}
