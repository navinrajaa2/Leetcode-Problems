class Solution {
    public int mostWordsFound(String[] sentences) {
        int maximum=0;
        for(String s:sentences){
            int word=1;
            for(int i=0;i<s.length();i++){
                if(s.charAt(i)==' '){
                    word++;
                }
            }
            maximum=Math.max(maximum,word);
        }
        return maximum;
    }
}
