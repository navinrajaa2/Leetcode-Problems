class leet504 {
    public String convertToBase7(int num) {
        if (num == 0)
            return "0";
        boolean isneg = num < 0;
        num = Math.abs(num);
        StringBuilder navin = new StringBuilder();
        while (num > 0) {
            navin.append(num % 7);
            num /= 7;
        }
        if (isneg)
            navin.append("-");
        return navin.reverse().toString();
    }
}
