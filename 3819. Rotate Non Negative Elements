class Solution {
    public int[] rotateElements(int[] nums, int k) {
        List<Integer> list = new ArrayList<>();
        for (int num : nums) {
            if (num >= 0) {
                list.add(num);
            }
        }
        int size = list.size();
        if (size == 0)
            return nums;
        k %= size;
        Collections.rotate(list, -k);
        int id = 0;
        for (int i = 0; i < nums.length; i++) {
            if (nums[i] >= 0) {
                nums[i] = list.get(id++);
            }
        }
        return nums;
    }
}
