class Solution {
    public boolean digitCount(String num) {
        int[] nums=new int[10];
        char[] ele=num.toCharArray();
        for(char element:ele){
            int digit=element-'0';
            nums[digit]++;
        }
        for(int i=0;i<num.length();i++){
            if(nums[i]!=num.charAt(i)-'0')return false;
        }
        return true;
    }
}
