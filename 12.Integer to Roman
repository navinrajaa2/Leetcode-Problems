class Solution {
    public static void main(String[] args) {
        int number = 109;
        System.out.println(intToRoman(number));
    }

    public static String intToRoman(int num) {
        int[] values = {
                1000, 900, 500, 400,
                100, 90, 50, 40,
                10, 9, 5, 4, 1
        };

        String[] symbols = {
                "M", "CM", "D", "CD",
                "C", "XC", "L", "XL",
                "X", "IX", "V", "IV", "I"
        };
        StringBuilder navin = new StringBuilder();
        for (int i = 0; i < values.length; i++) {
            while (num >= values[i]) {
                navin.append(symbols[i]);
                num -= values[i];
            }
        }
        return navin.toString();
    }
}
