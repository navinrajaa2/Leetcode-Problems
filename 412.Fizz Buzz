class Solution {
    public List<String> fizzBuzz(int n) {
        List<String> ans=new ArrayList<>();
        for(int i=1;i<=n;i++){
            boolean dividedby3=(i%3==0);
            boolean dividedby5=(i%5==0);
            if (i % 15 == 0) ans.add("FizzBuzz");
            else if (dividedby3) ans.add("Fizz");
            else if (dividedby5) ans.add("Buzz");
            else ans.add(String.valueOf(i));
        }
        return ans;
    }
}
