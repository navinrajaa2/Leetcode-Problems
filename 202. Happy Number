class Solution {

    public boolean isHappy(int n) {
        if (n == 1 || n == 7) {
            return true; 
        }else if (n < 10) {
            return false; 
        }else {
            int ans = 0;
            while (n > 0) {
                int remain = n % 10;
                ans += remain * remain;
                n = n / 10;
            }
            return isHappy(ans);
        }
    }
}
