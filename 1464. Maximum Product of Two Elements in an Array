class Solution {
    public int maxProduct(int[] nums) {
        int max1=0;
        int max2=0;
        int n=nums.length;
        for(int ele:nums){
            if(ele>max1){
                max2=max1;
                max1=ele;
            }
            else if(ele>max2){
                max2=ele;
            }
        }
        return (max2-1)*(max1-1);
    }
}
