class Solution {
    public boolean scoreBalance(String s) {
        char[] ch=s.toCharArray();
        for(int i=0;i<s.length();i++){
            int left=0;
            int right=0;
            for(int j=0;j<=i;j++){
                left+=ch[j]-'a'+1;
            }
            for(int j=i+1;j<s.length();j++){
                right+=ch[j]-'a'+1;
            }
            if(left==right)return true;
        }
        return false;
    }
}
