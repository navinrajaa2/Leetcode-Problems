class Solution {
    public int commonFactors(int a, int b) {
        int count=0;
        int g=gcd(a,b);
        for(int i=1;i<=g;i++){
            if(g%i==0){
                count++;
            }
        }
        return count;
    }
    public int gcd(int a, int b){
            if(b==0)return a;
            return gcd(b,a%b);
        }
}
