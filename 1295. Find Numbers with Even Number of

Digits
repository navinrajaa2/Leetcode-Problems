class Solution {
    public int findNumbers(int[] nums) {
        int count=0;
        for(int num:nums){
            if(totaldigit(num)%2==0)count++;
        }
        return count;
    }
    public int totaldigit(int num){
        int temp=num;
        int count=0;
        while(temp>0){
            count++;
            temp/=10;
        }
        return count;
    }
}