class Solution {
    public boolean judgeSquareSum(int c) {
        long sum=0;
        long start=0;
        long end=(long)Math.sqrt(c);
        while(start<=end){
            sum=start*start+end*end;
            if(sum==c){
                return true;
            }
            else if(sum<c){
                start++;
            }
            else{
                end--;
            }
        }
        return false;
    }
}
