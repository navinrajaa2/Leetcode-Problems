class Solution {
    public int lengthOfLastWord(String s) {
        int lens=s.length()-1;
        while(lens>=0 && s.charAt(lens)==' '){
            lens--;
        }
        int length=0;
        while(lens>=0&&s.charAt(lens)!=' '){
            length++;
            lens--;
        }
        return length;
    }
}
