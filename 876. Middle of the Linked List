class Solution {
    public ListNode middleNode(ListNode head) {
        if(head.next==null){
            return head;
        }
        ListNode current=head;
        int n=0;
        while(current!=null){
            n++;
            current=current.next;
        }
        int middle=n/2;
        current=head;
        for(int i=0;i<middle;i++){
            current=current.next;
        }

        return current;
    }
}
