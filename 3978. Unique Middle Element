class Solution {
    public boolean isMiddleElementUnique(int[] nums) {
        int n=nums.length;
        int mid=n/2;
        int middleelement=nums[mid];
        for(int i=0;i<n;i++){
            if(i==mid)continue;
            if(nums[i]==nums[mid])return false;
        }
        return true;
    }
}
