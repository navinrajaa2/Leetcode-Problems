class Solution {
    public int sumOfUnique(int[] nums) {
        int[] element=new int[101];
        for(int ele:nums){
            element[ele]++;
        }
        int sum=0;
        for(int i=0;i<101;i++){
            if(element[i]!=0 &&element[i]<2){
                sum+=i;
            }
        }
        return sum;
    }
}
