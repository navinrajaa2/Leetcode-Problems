class Solution {
    public int digitsum(int n ){
        int sum=0;
        while(n>0){
            sum+=n%10;
            n/=10;
        }
        return sum;
    }
    public int countEven(int num) {
        int sum=digitsum(num);
        if(sum%2==0){
            return num/2;
        }
        return (num-1)/2;
    }
}
