class Solution {
    public int sumOfEncryptedInt(int[] nums) {
        int sum=0;
       for(int num:nums){
        int max=0;
        int temp=num;
        int digit=0;
        while(temp>0){
            max=Math.max(max,temp%10);
            temp/=10;
            digit++;
        }
        int encrypt=0;
        for(int i=0;i<digit;i++){
            encrypt=encrypt*10+max;
        }
        sum+=encrypt;
       } 
       return sum;
    }
}
