class Solution {
    public int countSeniors(String[] details) {
        int n=details.length;
        int[] age=new int[n];
        for(int i=0;i<n;i++){
            age[i]=(details[i].charAt(11)-'0')*10+(details[i].charAt(12)-'0');
        }
        int count=0;
        for(int ele:age){
            if(ele>60){
                count++;
            }
        }
        return count;
    }
}
