class Solution {
    public String[] map = {
        "", "", "abc", "def", "ghi",
        "jkl", "mno", "pqrs", "tuv", "wxyz"
    };
    public List<String> letterCombinations(String digits) {
        return letter("",digits);
    }
    public List<String> letter(String p,String up){
        if(up.isEmpty()){
            ArrayList<String>navin=new ArrayList<>();
            navin.add(p);
            return navin;
        }
        int value=up.charAt(0)-'0';
        String letters=map[value];
        ArrayList<String>navin=new ArrayList<>();
        for(int i=0;i<letters.length();i++){
            char ch = letters.charAt(i); 
            navin.addAll(letter(p+ch,up.substring(1)));
        }
        return navin;
    }
}
