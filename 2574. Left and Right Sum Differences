class Solution {
    public int[] leftRightDifference(int[] nums) {
        int n=nums.length;
        int[] result=new int[n];
        int sum=0;
        for(int i=0;i<n;i++){
            sum+=nums[i];
        }
        int left=0;
        for(int i=0;i<n;i++){
            int right=sum-left-nums[i];
            result[i]=Math.abs(left-right);
            left+=nums[i];
        }
        return result;
    }
}
