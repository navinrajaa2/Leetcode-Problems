class Solution {
    public int[] sortArray(int[] nums) {
        mergesort(nums,0,nums.length-1);
        return nums;
    }
    public void mergesort(int[]nums ,int s,int e){
        if(s>=e) return;
        int mid = (s + e) / 2;
        mergesort(nums,s,mid);
        mergesort(nums,mid+1,e);
        merge(nums,s,mid,e);
    }
    public void merge(int[] nums,int s,int m,int e){
        int n1=m-s+1;
        int n2=e-m;
        int [] L=new int[n1];
        int [] R=new int[n2];
        for(int i=0;i<n1;i++){
            L[i]=nums[s+i];
        }
        for(int j=0;j<n2;j++){
            R[j]=nums[m+j+1];
        }
        int i=0,j=0,k=s;
        while(i<n1&&j<n2){
            if(L[i]<R[j]){
                nums[k]=L[i];
                i++;
            }
            else{
                nums[k]=R[j];
                j++;
            }
            k++;
        }
        while(i<n1){
            nums[k++]=L[i++];
        }
        while(j<n2){
            nums[k++]=R[j++];
        }
    }
}
